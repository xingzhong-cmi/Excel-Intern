# Excel助手 - 大模型 API 配置
#
# 将此文件复制为 .env 并填入您的 API 密钥
# cp .env.example .env
#
# 支持 OpenAI 兼容的 API（DeepSeek、OpenAI、Azure 等）

# API 密钥（必填）
LLM_API_KEY=your_api_key_here

# API 地址（默认为 DeepSeek）
LLM_API_URL=https://api.deepseek.com/v1/chat/completions

# 模型名称
LLM_MODEL=deepseek-chat

# 请求超时时间（秒）
LLM_TIMEOUT=120
